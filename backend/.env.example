PROJECT_NAME="AI Workflow Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_workflow"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Services
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-pro"

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Code Runner node executes user-supplied Python in-process (NOT a real sandbox).
# Disabled by default. UPGRADE NOTE: existing workflows containing a Code Runner node
# will have that node skipped (input passed through unchanged) unless this is true.
# Only enable in a trusted, isolated deployment.
ENABLE_CODE_NODE=false

# Admin bootstrap (optional): seeds an admin user on startup
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me"

# ── Security hardening ────────────────────────────────────────────────────────
# Strong random value; also derives the key that encrypts stored provider/node secrets
# unless ENCRYPTION_KEY is set. Changing it makes previously stored secrets unreadable.
# ENCRYPTION_KEY=""
# Block HTTP/KYC nodes from reaching private/loopback/metadata addresses (SSRF guard).
# Set true ONLY for local development against services on your own machine.
ALLOW_PRIVATE_URLS=false
# In-memory (per process) rate limits, requests per minute
AUTH_RATE_LIMIT_PER_MIN=10
TRIGGER_RATE_LIMIT_PER_MIN=60
# Static API tokens older than this many days are rejected until rotated (0 = never expire)
API_TOKEN_TTL_DAYS=0
# Execution inputs/outputs/traces older than this are purged (0 = keep forever)
EXECUTION_RETENTION_DAYS=30

# ── Background jobs (PostgreSQL-backed queue) ─────────────────────────────────
# Embedded worker/scheduler inside the API process. For scale, run `python -m app.worker`
# separately and set these to false on API instances.
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
MAX_SCHEDULES_PER_USER=20
MIN_SCHEDULE_INTERVAL_SECONDS=60
MAX_CONNECTIONS_PER_USER=50

# ── Data engine (pipelines) ───────────────────────────────────────────────────
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_STORAGE_MB_PER_USER=500
ENGINE_TIMEOUT_S=60
ENGINE_MEMORY_MB=512
ENGINE_MAX_CONCURRENT=2
DRY_RUN_ROWS=1000
DATASET_RETENTION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
